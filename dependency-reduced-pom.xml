<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.uth.sbmi</groupId>
  <artifactId>ontokeeper-core</artifactId>
  <name>Ontokeeper Core Library</name>
  <version>1.0.1</version>
  <build>
    <finalName>ontokeeper-core</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-eclipse-plugin</artifactId>
        <version>2.9</version>
        <configuration>
          <downloadSources>true</downloadSources>
          <downloadJavadocs>false</downloadJavadocs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>2.3.2</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>build-all</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-shade-plugin</artifactId>
            <version>${maven-shade-plugin.version}</version>
            <executions>
              <execution>
                <id>ontokeeper-ui</id>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>ui-mode</shadedClassifierName>
                  <transformers>
                    <transformer>
                      <mainClass>${main.class}</mainClass>
                    </transformer>
                  </transformers>
                  <finalName>ontokeeper-ui</finalName>
                </configuration>
              </execution>
              <execution>
                <id>github-deploy</id>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>github-version</shadedClassifierName>
                  <transformers>
                    <transformer>
                      <mainClass>${github.class}</mainClass>
                    </transformer>
                  </transformers>
                  <finalName>github-deploy</finalName>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <properties>
    <main.class>suite.ExecutableApp</main.class>
    <github.class>suite.GitHubScore</github.class>
    <maven-shade-plugin.version>3.5.3</maven-shade-plugin.version>
    <jdk.version>21</jdk.version>
  </properties>
</project>
